# RISC-V RV64I Base Integer Instruction Set
# QEMU decodetree format
# helm-ng project

# ============================================================================
# Field definitions
# ============================================================================

%rd        7:5
%rs1      15:5
%rs2      20:5
%rs3      27:5
%shamt    20:6
%shamt5   20:5
%csr      20:12
%rm       12:3
%aq       26:1
%rl       25:1
%pred     24:4
%succ     20:4

# Immediates
%imm_i    20:s12
%imm_s    25:s7 7:5
%imm_b    31:s1 7:1 25:6 8:4       !function=ex_shift_1
%imm_u    12:s20                    !function=ex_shift_12
%imm_j    31:s1 12:8 20:1 21:10    !function=ex_shift_1

# ============================================================================
# Argument sets
# ============================================================================

&r      rd rs1 rs2
&r2     rd rs1
&i      rd rs1 imm
&s      rs1 rs2 imm
&b      rs1 rs2 imm
&u      rd imm
&j      rd imm
&shift  rd rs1 shamt
&shift5 rd rs1 shamt5
&fence  pred succ

# ============================================================================
# Formats
# ============================================================================

@r       ....... ..... ..... ... ..... ....... &r      %rs2 %rs1 %rd
@r2      ....... ..... ..... ... ..... ....... &r2     %rs1 %rd
@i       ............ ..... ... ..... ....... &i       imm=%imm_i %rs1 %rd
@s       ....... ..... ..... ... ..... ....... &s      %rs2 %rs1 imm=%imm_s
@b       ....... ..... ..... ... ..... ....... &b      %rs2 %rs1 imm=%imm_b
@u       .................... ..... .......   &u       imm=%imm_u %rd
@j       .................... ..... .......   &j       imm=%imm_j %rd
@sh      ...... ...... ..... ... ..... ....... &shift  %shamt %rs1 %rd
@sh5     ....... ..... ..... ... ..... ....... &shift5 %shamt5 %rs1 %rd

# ============================================================================
# U-type instructions
# ============================================================================

LUI      .................... ..... 0110111   @u
AUIPC    .................... ..... 0010111   @u

# ============================================================================
# Jump instructions
# ============================================================================

JAL      .................... ..... 1101111   @j
JALR     ............ ..... 000 ..... 1100111 @i

# ============================================================================
# Branch instructions
# ============================================================================

BEQ      ....... ..... ..... 000 ..... 1100011 @b
BNE      ....... ..... ..... 001 ..... 1100011 @b
BLT      ....... ..... ..... 100 ..... 1100011 @b
BGE      ....... ..... ..... 101 ..... 1100011 @b
BLTU     ....... ..... ..... 110 ..... 1100011 @b
BGEU     ....... ..... ..... 111 ..... 1100011 @b

# ============================================================================
# Load instructions
# ============================================================================

LB       ............ ..... 000 ..... 0000011 @i
LH       ............ ..... 001 ..... 0000011 @i
LW       ............ ..... 010 ..... 0000011 @i
LD       ............ ..... 011 ..... 0000011 @i
LBU      ............ ..... 100 ..... 0000011 @i
LHU      ............ ..... 101 ..... 0000011 @i
LWU      ............ ..... 110 ..... 0000011 @i

# ============================================================================
# Store instructions
# ============================================================================

SB       ....... ..... ..... 000 ..... 0100011 @s
SH       ....... ..... ..... 001 ..... 0100011 @s
SW       ....... ..... ..... 010 ..... 0100011 @s
SD       ....... ..... ..... 011 ..... 0100011 @s

# ============================================================================
# Integer register-immediate instructions
# ============================================================================

ADDI     ............ ..... 000 ..... 0010011 @i
SLTI     ............ ..... 010 ..... 0010011 @i
SLTIU    ............ ..... 011 ..... 0010011 @i
XORI     ............ ..... 100 ..... 0010011 @i
ORI      ............ ..... 110 ..... 0010011 @i
ANDI     ............ ..... 111 ..... 0010011 @i

# Shifts (RV64: 6-bit shamt)
SLLI     000000 ...... ..... 001 ..... 0010011 @sh
SRLI     000000 ...... ..... 101 ..... 0010011 @sh
SRAI     010000 ...... ..... 101 ..... 0010011 @sh

# ============================================================================
# Integer register-register instructions
# ============================================================================

ADD      0000000 ..... ..... 000 ..... 0110011 @r
SUB      0100000 ..... ..... 000 ..... 0110011 @r
SLL      0000000 ..... ..... 001 ..... 0110011 @r
SLT      0000000 ..... ..... 010 ..... 0110011 @r
SLTU     0000000 ..... ..... 011 ..... 0110011 @r
XOR      0000000 ..... ..... 100 ..... 0110011 @r
SRL      0000000 ..... ..... 101 ..... 0110011 @r
SRA      0100000 ..... ..... 101 ..... 0110011 @r
OR       0000000 ..... ..... 110 ..... 0110011 @r
AND      0000000 ..... ..... 111 ..... 0110011 @r

# ============================================================================
# RV64I word-width instructions (32-bit on 64-bit)
# ============================================================================

ADDIW    ............ ..... 000 ..... 0011011 @i
SLLIW    0000000 ..... ..... 001 ..... 0011011 @sh5
SRLIW    0000000 ..... ..... 101 ..... 0011011 @sh5
SRAIW    0100000 ..... ..... 101 ..... 0011011 @sh5

ADDW     0000000 ..... ..... 000 ..... 0111011 @r
SUBW     0100000 ..... ..... 000 ..... 0111011 @r
SLLW     0000000 ..... ..... 001 ..... 0111011 @r
SRLW     0000000 ..... ..... 101 ..... 0111011 @r
SRAW     0100000 ..... ..... 101 ..... 0111011 @r

# ============================================================================
# Fence instructions
# ============================================================================

FENCE    .... .... ..... 00000 000 00000 0001111 &fence %pred %succ
FENCE_I  000000000000 00000 001 00000 0001111

# ============================================================================
# System instructions
# ============================================================================

ECALL    000000000000 00000 000 00000 1110011
EBREAK   000000000001 00000 000 00000 1110011

# ============================================================================
# Privileged instructions
# ============================================================================

MRET     0011000 00010 00000 000 00000 1110011
SRET     0001000 00010 00000 000 00000 1110011
WFI      0001000 00101 00000 000 00000 1110011
SFENCE_VMA  0001001 ..... ..... 000 00000 1110011 %rs2 %rs1
