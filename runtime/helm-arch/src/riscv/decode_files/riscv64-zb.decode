# RISC-V Zb* Extensions — Bit Manipulation
# Includes: Zba, Zbb, Zbs, Zbc, Zbkb
# QEMU decodetree format
# helm-ng project

# ============================================================================
# Field definitions
# ============================================================================

%rd       7:5
%rs1     15:5
%rs2     20:5
%shamt   20:6
%shamt5  20:5

# ============================================================================
# Argument sets and formats
# ============================================================================

&r       rd rs1 rs2
&r2      rd rs1
&shift   rd rs1 shamt
&shift5  rd rs1 shamt5

@r       ....... ..... ..... ... ..... ....... &r      %rs2 %rs1 %rd
@r2      ....... ..... ..... ... ..... ....... &r2     %rs1 %rd
@sh      ...... ...... ..... ... ..... ....... &shift  %shamt %rs1 %rd
@sh5     ....... ..... ..... ... ..... ....... &shift5 %shamt5 %rs1 %rd

# ============================================================================
# Zba — Address Generation
# ============================================================================

SH1ADD     0010000 ..... ..... 010 ..... 0110011 @r
SH2ADD     0010000 ..... ..... 100 ..... 0110011 @r
SH3ADD     0010000 ..... ..... 110 ..... 0110011 @r
ADD_UW     0000100 ..... ..... 000 ..... 0111011 @r
SLLI_UW    000010 ...... ..... 001 ..... 0011011 @sh
SH1ADD_UW  0010000 ..... ..... 010 ..... 0111011 @r
SH2ADD_UW  0010000 ..... ..... 100 ..... 0111011 @r
SH3ADD_UW  0010000 ..... ..... 110 ..... 0111011 @r

# ============================================================================
# Zbb — Basic Bit Manipulation
# ============================================================================

# Logical with negate
ANDN     0100000 ..... ..... 111 ..... 0110011 @r
ORN      0100000 ..... ..... 110 ..... 0110011 @r
XNOR     0100000 ..... ..... 100 ..... 0110011 @r

# Count leading/trailing zeros, population count
CLZ      0110000 00000 ..... 001 ..... 0010011 @r2
CTZ      0110000 00001 ..... 001 ..... 0010011 @r2
CPOP     0110000 00010 ..... 001 ..... 0010011 @r2
CLZW     0110000 00000 ..... 001 ..... 0011011 @r2
CTZW     0110000 00001 ..... 001 ..... 0011011 @r2
CPOPW    0110000 00010 ..... 001 ..... 0011011 @r2

# Min / Max
MAX      0000101 ..... ..... 110 ..... 0110011 @r
MAXU     0000101 ..... ..... 111 ..... 0110011 @r
MIN      0000101 ..... ..... 100 ..... 0110011 @r
MINU     0000101 ..... ..... 101 ..... 0110011 @r

# Sign / Zero extend
SEXT_B   0110000 00100 ..... 001 ..... 0010011 @r2
SEXT_H   0110000 00101 ..... 001 ..... 0010011 @r2
ZEXT_H   0000100 00000 ..... 100 ..... 0110011 @r2

# Rotate
ROL      0110000 ..... ..... 001 ..... 0110011 @r
ROLW     0110000 ..... ..... 001 ..... 0111011 @r
ROR      0110000 ..... ..... 101 ..... 0110011 @r
RORW     0110000 ..... ..... 101 ..... 0111011 @r
RORI     011000 ...... ..... 101 ..... 0010011 @sh
RORIW    0110000 ..... ..... 101 ..... 0011011 @sh5

# Byte operations
ORC_B    0010100 00111 ..... 101 ..... 0010011 @r2
REV8     0110101 11000 ..... 101 ..... 0010011 @r2

# ============================================================================
# Zbs — Single-Bit Instructions
# ============================================================================

BCLR     0100100 ..... ..... 001 ..... 0110011 @r
BCLRI    010010 ...... ..... 001 ..... 0010011 @sh
BSET     0010100 ..... ..... 001 ..... 0110011 @r
BSETI    001010 ...... ..... 001 ..... 0010011 @sh
BINV     0110100 ..... ..... 001 ..... 0110011 @r
BINVI    011010 ...... ..... 001 ..... 0010011 @sh
BEXT     0100100 ..... ..... 101 ..... 0110011 @r
BEXTI    010010 ...... ..... 101 ..... 0010011 @sh

# ============================================================================
# Zbc — Carry-less Multiplication
# ============================================================================

CLMUL    0000101 ..... ..... 001 ..... 0110011 @r
CLMULH   0000101 ..... ..... 011 ..... 0110011 @r
CLMULR   0000101 ..... ..... 010 ..... 0110011 @r

# ============================================================================
# Zbkb — Bit Manipulation for Cryptography
# ============================================================================

BREV8    0110100 00111 ..... 101 ..... 0010011 @r2
PACK     0000100 ..... ..... 100 ..... 0110011 @r
PACKH    0000100 ..... ..... 111 ..... 0110011 @r
PACKW    0000100 ..... ..... 100 ..... 0111011 @r
