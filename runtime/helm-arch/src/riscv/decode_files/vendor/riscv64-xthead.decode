# RISC-V XThead Vendor Extensions — T-HEAD (Alibaba/DAMO Academy)
# Includes: XTheadMemory, XTheadArith, XTheadSync, XTheadCache,
#           XTheadCondMov, XTheadBitOps, XTheadMac
# QEMU decodetree format
# helm-ng project
#
# T-HEAD custom instructions use opcode 0001011 (custom-0) and 1111011 (custom-3)

# ============================================================================
# Field definitions
# ============================================================================

%rd       7:5
%rs1     15:5
%rs2     20:5
%imm_i   20:s12

# ============================================================================
# Argument sets and formats
# ============================================================================

&r       rd rs1 rs2
&r2      rd rs1
&i       rd rs1 imm

@r       ....... ..... ..... ... ..... ....... &r  %rs2 %rs1 %rd
@r2      ....... ..... ..... ... ..... ....... &r2 %rs1 %rd
@i       ............ ..... ... ..... ....... &i  imm=%imm_i %rs1 %rd

# ============================================================================
# XTheadMemIdx — Indexed Memory Access (custom-0: 0001011)
#
# Format: funct7[31:25] rs2[24:20] rs1[19:15] funct3[14:12] rd[11:7] 0001011
# ============================================================================

# Indexed loads: base + index register
TH_LRB     0110000 ..... ..... 000 ..... 0001011  @r
TH_LRBU    0110000 ..... ..... 100 ..... 0001011  @r
TH_LRH     0110000 ..... ..... 001 ..... 0001011  @r
TH_LRHU    0110000 ..... ..... 101 ..... 0001011  @r
TH_LRW     0110000 ..... ..... 010 ..... 0001011  @r
TH_LRWU    0110000 ..... ..... 110 ..... 0001011  @r
TH_LRD     0110000 ..... ..... 011 ..... 0001011  @r

# Indexed loads with shift: base + (index << imm2)
TH_LURB    0010000 ..... ..... 000 ..... 0001011  @r
TH_LURBU   0010000 ..... ..... 100 ..... 0001011  @r
TH_LURH    0010000 ..... ..... 001 ..... 0001011  @r
TH_LURHU   0010000 ..... ..... 101 ..... 0001011  @r
TH_LURW    0010000 ..... ..... 010 ..... 0001011  @r
TH_LURWU   0010000 ..... ..... 110 ..... 0001011  @r
TH_LURD    0010000 ..... ..... 011 ..... 0001011  @r

# Indexed stores: base + index register
TH_SRB     0110010 ..... ..... 000 ..... 0001011  @r
TH_SRH     0110010 ..... ..... 001 ..... 0001011  @r
TH_SRW     0110010 ..... ..... 010 ..... 0001011  @r
TH_SRD     0110010 ..... ..... 011 ..... 0001011  @r

# Indexed stores with shift
TH_SURB    0010010 ..... ..... 000 ..... 0001011  @r
TH_SURH    0010010 ..... ..... 001 ..... 0001011  @r
TH_SURW    0010010 ..... ..... 010 ..... 0001011  @r
TH_SURD    0010010 ..... ..... 011 ..... 0001011  @r

# ============================================================================
# XTheadBa — Address Calculation
# ============================================================================

# ADDSL rd, rs1, rs2, imm2 — rd = rs1 + (rs2 << imm2)
TH_ADDSL   0000000 ..... ..... 001 ..... 0001011  @r

# ============================================================================
# XTheadCondMov — Conditional Move
# ============================================================================

# MVEQZ rd, rs1, rs2 — if rs2==0, rd=rs1
TH_MVEQZ   0100000 ..... ..... 001 ..... 0001011  @r

# MVNEZ rd, rs1, rs2 — if rs2!=0, rd=rs1
TH_MVNEZ   0100000 ..... ..... 010 ..... 0001011  @r

# ============================================================================
# XTheadMac — Multiply-Accumulate
# ============================================================================

# MULA rd, rs1, rs2 — rd += rs1 * rs2
TH_MULA    0010000 ..... ..... 000 ..... 1111011  @r

# MULS rd, rs1, rs2 — rd -= rs1 * rs2
TH_MULS    0010010 ..... ..... 000 ..... 1111011  @r

# MULAH rd, rs1, rs2 — rd += (rs1[15:0] * rs2[15:0]) sign-extended
TH_MULAH   0010100 ..... ..... 000 ..... 1111011  @r

# MULSH rd, rs1, rs2 — rd -= (rs1[15:0] * rs2[15:0]) sign-extended
TH_MULSH   0010100 ..... ..... 001 ..... 1111011  @r

# Word-width multiply-accumulate
TH_MULAW   0010000 ..... ..... 001 ..... 1111011  @r
TH_MULSW   0010010 ..... ..... 001 ..... 1111011  @r

# ============================================================================
# XTheadSync — Synchronization
# ============================================================================

TH_SYNC     0000000 11000 00000 000 00000 0001011
TH_SYNC_S   0000000 11001 00000 000 00000 0001011
TH_SYNC_I   0000000 11010 00000 000 00000 0001011
TH_SYNC_IS  0000000 11011 00000 000 00000 0001011

# ============================================================================
# XTheadCmo — Cache Management Operations
#
# All use rs1 as address register, rd=0
# ============================================================================

# D-cache operations
TH_DCACHE_CALL   0000000 00001 00000 000 00000 0001011
TH_DCACHE_IALL   0000000 00010 00000 000 00000 0001011
TH_DCACHE_CIALL  0000000 00011 00000 000 00000 0001011
TH_DCACHE_CSW    0000001 00001 ..... 000 00000 0001011  %rs1
TH_DCACHE_ISW    0000001 00010 ..... 000 00000 0001011  %rs1
TH_DCACHE_CISW   0000001 00011 ..... 000 00000 0001011  %rs1
TH_DCACHE_CVA    0000001 00101 ..... 000 00000 0001011  %rs1
TH_DCACHE_IVA    0000001 00110 ..... 000 00000 0001011  %rs1
TH_DCACHE_CIVA   0000001 00111 ..... 000 00000 0001011  %rs1
TH_DCACHE_CPA    0000001 01001 ..... 000 00000 0001011  %rs1
TH_DCACHE_IPA    0000001 01010 ..... 000 00000 0001011  %rs1
TH_DCACHE_CIPA   0000001 01011 ..... 000 00000 0001011  %rs1

# I-cache operations
TH_ICACHE_IALL   0000000 10000 00000 000 00000 0001011
TH_ICACHE_IALLS  0000000 10001 00000 000 00000 0001011
TH_ICACHE_IVA    0000001 10000 ..... 000 00000 0001011  %rs1
TH_ICACHE_IPA    0000001 11000 ..... 000 00000 0001011  %rs1

# L2-cache operations
TH_L2CACHE_CALL  0000000 10101 00000 000 00000 0001011
TH_L2CACHE_IALL  0000000 10110 00000 000 00000 0001011
TH_L2CACHE_CIALL 0000000 10111 00000 000 00000 0001011

# ============================================================================
# XTheadBb — Bit-manipulation
# ============================================================================

# FF0 — find first zero (from MSB)
TH_FF0     1000010 00000 ..... 001 ..... 0001011  @r2

# FF1 — find first one (from MSB)
TH_FF1     1000010 00000 ..... 010 ..... 0001011  @r2

# REV — byte-reverse full register
TH_REV     1000010 00000 ..... 011 ..... 0001011  @r2

# REVW — byte-reverse lower 32 bits
TH_REVW    1001000 00000 ..... 001 ..... 0001011  @r2

# TSTNBZ — test non-zero bytes
TH_TSTNBZ  1000010 00000 ..... 100 ..... 0001011  @r2

# EXT/EXTU — bit-field extract (signed/unsigned)
# Encoding: imm[msb:lsb] packed in instruction; using rs2 field for width encoding
TH_EXT     0000001 ..... ..... 010 ..... 0001011  @r
TH_EXTU    0000001 ..... ..... 011 ..... 0001011  @r
