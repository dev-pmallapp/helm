# RISC-V RV64A Standard Extension — Atomics
# QEMU decodetree format
# helm-ng project

# ============================================================================
# Field definitions
# ============================================================================

%rd       7:5
%rs1     15:5
%rs2     20:5
%aq      26:1
%rl      25:1

# ============================================================================
# Argument sets and formats
# ============================================================================

&atom    rd rs1 rs2 aq rl
&atom_ld rd rs1 aq rl

@atom    ..... . . ..... ..... ... ..... ....... &atom    %rs2 %rs1 %rd %aq %rl
@atom_ld ..... . . ..... ..... ... ..... ....... &atom_ld %rs1 %rd %aq %rl

# ============================================================================
# RV64A — 32-bit Atomics (RV32A base)
# ============================================================================

LR_W       00010 . . 00000 ..... 010 ..... 0101111 @atom_ld
SC_W       00011 . . ..... ..... 010 ..... 0101111 @atom
AMOSWAP_W  00001 . . ..... ..... 010 ..... 0101111 @atom
AMOADD_W   00000 . . ..... ..... 010 ..... 0101111 @atom
AMOXOR_W   00100 . . ..... ..... 010 ..... 0101111 @atom
AMOAND_W   01100 . . ..... ..... 010 ..... 0101111 @atom
AMOOR_W    01000 . . ..... ..... 010 ..... 0101111 @atom
AMOMIN_W   10000 . . ..... ..... 010 ..... 0101111 @atom
AMOMAX_W   10100 . . ..... ..... 010 ..... 0101111 @atom
AMOMINU_W  11000 . . ..... ..... 010 ..... 0101111 @atom
AMOMAXU_W  11100 . . ..... ..... 010 ..... 0101111 @atom

# ============================================================================
# RV64A — 64-bit Atomics
# ============================================================================

LR_D       00010 . . 00000 ..... 011 ..... 0101111 @atom_ld
SC_D       00011 . . ..... ..... 011 ..... 0101111 @atom
AMOSWAP_D  00001 . . ..... ..... 011 ..... 0101111 @atom
AMOADD_D   00000 . . ..... ..... 011 ..... 0101111 @atom
AMOXOR_D   00100 . . ..... ..... 011 ..... 0101111 @atom
AMOAND_D   01100 . . ..... ..... 011 ..... 0101111 @atom
AMOOR_D    01000 . . ..... ..... 011 ..... 0101111 @atom
AMOMIN_D   10000 . . ..... ..... 011 ..... 0101111 @atom
AMOMAX_D   10100 . . ..... ..... 011 ..... 0101111 @atom
AMOMINU_D  11000 . . ..... ..... 011 ..... 0101111 @atom
AMOMAXU_D  11100 . . ..... ..... 011 ..... 0101111 @atom
