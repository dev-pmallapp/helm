# RISC-V RVV — Vector Extension
# QEMU decodetree format
# helm-ng project

# ============================================================================
# Field definitions
# ============================================================================

%rd       7:5
%rs1     15:5
%rs2     20:5
%vd       7:5
%vs1     15:5
%vs2     20:5
%vs3      7:5
%vm      25:1
%nf      29:3
%mew     28:1
%mop     26:2
%lumop   20:5
%sumop   20:5
%width   12:3
%simm5   15:s5

# ============================================================================
# Argument sets
# ============================================================================

&r        rd rs1 rs2
&r2       rd rs1

# Vector configuration
&vsetvli  rd rs1 vtypei
&vsetivli rd uimm vtypei
&vsetvl   rd rs1 rs2

# Vector load/store unit-stride
&vlunit   vd rs1 vm nf mew
&vsunit   vs3 rs1 vm nf mew

# Vector register arithmetic (VV = vector-vector)
&vv       vd vs2 vs1 vm
&vx       vd vs2 rs1 vm
&vi       vd vs2 simm5 vm

# Vector unary
&v_unary  vd vs2 vm

# ============================================================================
# Formats
# ============================================================================

@r       ....... ..... ..... ... ..... ....... &r  %rs2 %rs1 %rd
@r2      ....... ..... ..... ... ..... ....... &r2 %rs1 %rd

# Vector arithmetic formats
@vv      ...... . ..... ..... ... ..... ....... &vv  %vd %vs2 %vs1 %vm
@vx      ...... . ..... ..... ... ..... ....... &vx  %vd %vs2 %rs1 %vm
@vi      ...... . ..... ..... ... ..... ....... &vi  %vd %vs2 %simm5 %vm

# ============================================================================
# Vector Configuration Instructions (vsetvl family)
# ============================================================================

# vsetvli rd, rs1, vtypei[10:0]
VSETVLI   0 ........... ..... 111 ..... 1010111  &vsetvli %rd %rs1 vtypei=20:11

# vsetivli rd, uimm[4:0], vtypei[9:0]
VSETIVLI  11 .......... ..... 111 ..... 1010111  &vsetivli %rd uimm=%rs1 vtypei=20:10

# vsetvl rd, rs1, rs2
VSETVL    1000000 ..... ..... 111 ..... 1010111  &vsetvl %rd %rs1 %rs2

# ============================================================================
# Vector Unit-Stride Load Instructions (opcode = 0000111)
#
# Encoding: nf[31:29] mew[28] mop[27:26] vm[25] lumop[24:20] rs1[19:15]
#           width[14:12] vd[11:7] 0000111
# For unit-stride: mop=00, lumop=00000
# ============================================================================

# Unit-stride loads — 8/16/32/64 bit element widths
VLE8_V    ... 0 00 . 00000 ..... 000 ..... 0000111  &vlunit %vd %rs1 %vm %nf %mew
VLE16_V   ... 0 00 . 00000 ..... 101 ..... 0000111  &vlunit %vd %rs1 %vm %nf %mew
VLE32_V   ... 0 00 . 00000 ..... 110 ..... 0000111  &vlunit %vd %rs1 %vm %nf %mew
VLE64_V   ... 0 00 . 00000 ..... 111 ..... 0000111  &vlunit %vd %rs1 %vm %nf %mew

# Whole-register loads (lumop=01000, vm=1, nf encodes nreg-1)
VL1RE8_V  000 0 00 1 01000 ..... 000 ..... 0000111  %vd %rs1
VL1RE16_V 000 0 00 1 01000 ..... 101 ..... 0000111  %vd %rs1
VL1RE32_V 000 0 00 1 01000 ..... 110 ..... 0000111  %vd %rs1
VL1RE64_V 000 0 00 1 01000 ..... 111 ..... 0000111  %vd %rs1
VL2RE8_V  001 0 00 1 01000 ..... 000 ..... 0000111  %vd %rs1
VL2RE16_V 001 0 00 1 01000 ..... 101 ..... 0000111  %vd %rs1
VL2RE32_V 001 0 00 1 01000 ..... 110 ..... 0000111  %vd %rs1
VL2RE64_V 001 0 00 1 01000 ..... 111 ..... 0000111  %vd %rs1
VL4RE8_V  011 0 00 1 01000 ..... 000 ..... 0000111  %vd %rs1
VL4RE16_V 011 0 00 1 01000 ..... 101 ..... 0000111  %vd %rs1
VL4RE32_V 011 0 00 1 01000 ..... 110 ..... 0000111  %vd %rs1
VL4RE64_V 011 0 00 1 01000 ..... 111 ..... 0000111  %vd %rs1
VL8RE8_V  111 0 00 1 01000 ..... 000 ..... 0000111  %vd %rs1
VL8RE16_V 111 0 00 1 01000 ..... 101 ..... 0000111  %vd %rs1
VL8RE32_V 111 0 00 1 01000 ..... 110 ..... 0000111  %vd %rs1
VL8RE64_V 111 0 00 1 01000 ..... 111 ..... 0000111  %vd %rs1

# Mask load (lumop=01011, eew=8, vm=1)
VLM_V     000 0 00 1 01011 ..... 000 ..... 0000111  %vd %rs1

# Strided loads (mop=10)
VLSE8_V   ... 0 10 . ..... ..... 000 ..... 0000111  &vlunit %vd %rs1 %vm %nf %mew
VLSE16_V  ... 0 10 . ..... ..... 101 ..... 0000111  &vlunit %vd %rs1 %vm %nf %mew
VLSE32_V  ... 0 10 . ..... ..... 110 ..... 0000111  &vlunit %vd %rs1 %vm %nf %mew
VLSE64_V  ... 0 10 . ..... ..... 111 ..... 0000111  &vlunit %vd %rs1 %vm %nf %mew

# Indexed loads (mop=01 unordered, mop=11 ordered)
VLUXEI8_V  ... 0 01 . ..... ..... 000 ..... 0000111 &vlunit %vd %rs1 %vm %nf %mew
VLUXEI16_V ... 0 01 . ..... ..... 101 ..... 0000111 &vlunit %vd %rs1 %vm %nf %mew
VLUXEI32_V ... 0 01 . ..... ..... 110 ..... 0000111 &vlunit %vd %rs1 %vm %nf %mew
VLUXEI64_V ... 0 01 . ..... ..... 111 ..... 0000111 &vlunit %vd %rs1 %vm %nf %mew
VLOXEI8_V  ... 0 11 . ..... ..... 000 ..... 0000111 &vlunit %vd %rs1 %vm %nf %mew
VLOXEI16_V ... 0 11 . ..... ..... 101 ..... 0000111 &vlunit %vd %rs1 %vm %nf %mew
VLOXEI32_V ... 0 11 . ..... ..... 110 ..... 0000111 &vlunit %vd %rs1 %vm %nf %mew
VLOXEI64_V ... 0 11 . ..... ..... 111 ..... 0000111 &vlunit %vd %rs1 %vm %nf %mew

# ============================================================================
# Vector Unit-Stride Store Instructions (opcode = 0100111)
#
# Encoding: nf[31:29] mew[28] mop[27:26] vm[25] sumop[24:20] rs1[19:15]
#           width[14:12] vs3[11:7] 0100111
# For unit-stride: mop=00, sumop=00000
# ============================================================================

# Unit-stride stores
VSE8_V    ... 0 00 . 00000 ..... 000 ..... 0100111  &vsunit %vs3 %rs1 %vm %nf %mew
VSE16_V   ... 0 00 . 00000 ..... 101 ..... 0100111  &vsunit %vs3 %rs1 %vm %nf %mew
VSE32_V   ... 0 00 . 00000 ..... 110 ..... 0100111  &vsunit %vs3 %rs1 %vm %nf %mew
VSE64_V   ... 0 00 . 00000 ..... 111 ..... 0100111  &vsunit %vs3 %rs1 %vm %nf %mew

# Whole-register stores
VS1R_V    000 0 00 1 01000 ..... 000 ..... 0100111  %vs3 %rs1
VS2R_V    001 0 00 1 01000 ..... 000 ..... 0100111  %vs3 %rs1
VS4R_V    011 0 00 1 01000 ..... 000 ..... 0100111  %vs3 %rs1
VS8R_V    111 0 00 1 01000 ..... 000 ..... 0100111  %vs3 %rs1

# Mask store
VSM_V     000 0 00 1 01011 ..... 000 ..... 0100111  %vs3 %rs1

# Strided stores (mop=10)
VSSE8_V   ... 0 10 . ..... ..... 000 ..... 0100111  &vsunit %vs3 %rs1 %vm %nf %mew
VSSE16_V  ... 0 10 . ..... ..... 101 ..... 0100111  &vsunit %vs3 %rs1 %vm %nf %mew
VSSE32_V  ... 0 10 . ..... ..... 110 ..... 0100111  &vsunit %vs3 %rs1 %vm %nf %mew
VSSE64_V  ... 0 10 . ..... ..... 111 ..... 0100111  &vsunit %vs3 %rs1 %vm %nf %mew

# Indexed stores (mop=01 unordered, mop=11 ordered)
VSUXEI8_V  ... 0 01 . ..... ..... 000 ..... 0100111 &vsunit %vs3 %rs1 %vm %nf %mew
VSUXEI16_V ... 0 01 . ..... ..... 101 ..... 0100111 &vsunit %vs3 %rs1 %vm %nf %mew
VSUXEI32_V ... 0 01 . ..... ..... 110 ..... 0100111 &vsunit %vs3 %rs1 %vm %nf %mew
VSUXEI64_V ... 0 01 . ..... ..... 111 ..... 0100111 &vsunit %vs3 %rs1 %vm %nf %mew
VSOXEI8_V  ... 0 11 . ..... ..... 000 ..... 0100111 &vsunit %vs3 %rs1 %vm %nf %mew
VSOXEI16_V ... 0 11 . ..... ..... 101 ..... 0100111 &vsunit %vs3 %rs1 %vm %nf %mew
VSOXEI32_V ... 0 11 . ..... ..... 110 ..... 0100111 &vsunit %vs3 %rs1 %vm %nf %mew
VSOXEI64_V ... 0 11 . ..... ..... 111 ..... 0100111 &vsunit %vs3 %rs1 %vm %nf %mew

# ============================================================================
# Vector Integer Arithmetic Instructions (opcode = 1010111)
#
# funct6[31:26] vm[25] vs2[24:20] vs1/rs1/imm[19:15] funct3[14:12] vd[11:7]
# funct3: 000=OPIVV, 001=OPFVV, 010=OPMVV, 011=OPIVI, 100=OPIVX, 101=OPFVF,
#         110=OPMVX
# ============================================================================

# --- Add / Sub ---
VADD_VV    000000 . ..... ..... 000 ..... 1010111  @vv
VADD_VX    000000 . ..... ..... 100 ..... 1010111  @vx
VADD_VI    000000 . ..... ..... 011 ..... 1010111  @vi
VSUB_VV    000010 . ..... ..... 000 ..... 1010111  @vv
VSUB_VX    000010 . ..... ..... 100 ..... 1010111  @vx
VRSUB_VX   000011 . ..... ..... 100 ..... 1010111  @vx
VRSUB_VI   000011 . ..... ..... 011 ..... 1010111  @vi

# --- Widening add/sub ---
VWADDU_VV  110000 . ..... ..... 010 ..... 1010111  @vv
VWADDU_VX  110000 . ..... ..... 110 ..... 1010111  @vx
VWSUBU_VV  110010 . ..... ..... 010 ..... 1010111  @vv
VWSUBU_VX  110010 . ..... ..... 110 ..... 1010111  @vx
VWADD_VV   110001 . ..... ..... 010 ..... 1010111  @vv
VWADD_VX   110001 . ..... ..... 110 ..... 1010111  @vx
VWSUB_VV   110011 . ..... ..... 010 ..... 1010111  @vv
VWSUB_VX   110011 . ..... ..... 110 ..... 1010111  @vx

# --- Bitwise ---
VAND_VV    001001 . ..... ..... 000 ..... 1010111  @vv
VAND_VX    001001 . ..... ..... 100 ..... 1010111  @vx
VAND_VI    001001 . ..... ..... 011 ..... 1010111  @vi
VOR_VV     001010 . ..... ..... 000 ..... 1010111  @vv
VOR_VX     001010 . ..... ..... 100 ..... 1010111  @vx
VOR_VI     001010 . ..... ..... 011 ..... 1010111  @vi
VXOR_VV    001011 . ..... ..... 000 ..... 1010111  @vv
VXOR_VX    001011 . ..... ..... 100 ..... 1010111  @vx
VXOR_VI    001011 . ..... ..... 011 ..... 1010111  @vi

# --- Shift ---
VSLL_VV    100101 . ..... ..... 000 ..... 1010111  @vv
VSLL_VX    100101 . ..... ..... 100 ..... 1010111  @vx
VSLL_VI    100101 . ..... ..... 011 ..... 1010111  @vi
VSRL_VV    101000 . ..... ..... 000 ..... 1010111  @vv
VSRL_VX    101000 . ..... ..... 100 ..... 1010111  @vx
VSRL_VI    101000 . ..... ..... 011 ..... 1010111  @vi
VSRA_VV    101001 . ..... ..... 000 ..... 1010111  @vv
VSRA_VX    101001 . ..... ..... 100 ..... 1010111  @vx
VSRA_VI    101001 . ..... ..... 011 ..... 1010111  @vi

# --- Compare (produce mask) ---
VMSEQ_VV   011000 . ..... ..... 000 ..... 1010111  @vv
VMSEQ_VX   011000 . ..... ..... 100 ..... 1010111  @vx
VMSEQ_VI   011000 . ..... ..... 011 ..... 1010111  @vi
VMSNE_VV   011001 . ..... ..... 000 ..... 1010111  @vv
VMSNE_VX   011001 . ..... ..... 100 ..... 1010111  @vx
VMSNE_VI   011001 . ..... ..... 011 ..... 1010111  @vi
VMSLTU_VV  011010 . ..... ..... 000 ..... 1010111  @vv
VMSLTU_VX  011010 . ..... ..... 100 ..... 1010111  @vx
VMSLT_VV   011011 . ..... ..... 000 ..... 1010111  @vv
VMSLT_VX   011011 . ..... ..... 100 ..... 1010111  @vx
VMSLEU_VV  011100 . ..... ..... 000 ..... 1010111  @vv
VMSLEU_VX  011100 . ..... ..... 100 ..... 1010111  @vx
VMSLEU_VI  011100 . ..... ..... 011 ..... 1010111  @vi
VMSLE_VV   011101 . ..... ..... 000 ..... 1010111  @vv
VMSLE_VX   011101 . ..... ..... 100 ..... 1010111  @vx
VMSLE_VI   011101 . ..... ..... 011 ..... 1010111  @vi
VMSGTU_VX  011110 . ..... ..... 100 ..... 1010111  @vx
VMSGTU_VI  011110 . ..... ..... 011 ..... 1010111  @vi
VMSGT_VX   011111 . ..... ..... 100 ..... 1010111  @vx
VMSGT_VI   011111 . ..... ..... 011 ..... 1010111  @vi

# --- Min / Max ---
VMINU_VV   000100 . ..... ..... 000 ..... 1010111  @vv
VMINU_VX   000100 . ..... ..... 100 ..... 1010111  @vx
VMIN_VV    000101 . ..... ..... 000 ..... 1010111  @vv
VMIN_VX    000101 . ..... ..... 100 ..... 1010111  @vx
VMAXU_VV   000110 . ..... ..... 000 ..... 1010111  @vv
VMAXU_VX   000110 . ..... ..... 100 ..... 1010111  @vx
VMAX_VV    000111 . ..... ..... 000 ..... 1010111  @vv
VMAX_VX    000111 . ..... ..... 100 ..... 1010111  @vx

# --- Multiply ---
VMUL_VV    100101 . ..... ..... 010 ..... 1010111  @vv
VMUL_VX    100101 . ..... ..... 110 ..... 1010111  @vx
VMULH_VV   100111 . ..... ..... 010 ..... 1010111  @vv
VMULH_VX   100111 . ..... ..... 110 ..... 1010111  @vx
VMULHU_VV  100100 . ..... ..... 010 ..... 1010111  @vv
VMULHU_VX  100100 . ..... ..... 110 ..... 1010111  @vx
VMULHSU_VV 100110 . ..... ..... 010 ..... 1010111  @vv
VMULHSU_VX 100110 . ..... ..... 110 ..... 1010111  @vx

# --- Divide ---
VDIVU_VV   100000 . ..... ..... 010 ..... 1010111  @vv
VDIVU_VX   100000 . ..... ..... 110 ..... 1010111  @vx
VDIV_VV    100001 . ..... ..... 010 ..... 1010111  @vv
VDIV_VX    100001 . ..... ..... 110 ..... 1010111  @vx
VREMU_VV   100010 . ..... ..... 010 ..... 1010111  @vv
VREMU_VX   100010 . ..... ..... 110 ..... 1010111  @vx
VREM_VV    100011 . ..... ..... 010 ..... 1010111  @vv
VREM_VX    100011 . ..... ..... 110 ..... 1010111  @vx

# --- Multiply-Add ---
VMACC_VV   101101 . ..... ..... 010 ..... 1010111  @vv
VMACC_VX   101101 . ..... ..... 110 ..... 1010111  @vx
VNMSAC_VV  101111 . ..... ..... 010 ..... 1010111  @vv
VNMSAC_VX  101111 . ..... ..... 110 ..... 1010111  @vx
VMADD_VV   101001 . ..... ..... 010 ..... 1010111  @vv
VMADD_VX   101001 . ..... ..... 110 ..... 1010111  @vx
VNMSUB_VV  101011 . ..... ..... 010 ..... 1010111  @vv
VNMSUB_VX  101011 . ..... ..... 110 ..... 1010111  @vx

# --- Merge / Move ---
# VMV_V_V is VADD_VV with vs2=v0, vm=1 (unmasked); separate encoding:
VMERGE_VVM 010111 0 ..... ..... 000 ..... 1010111  @vv
VMERGE_VXM 010111 0 ..... ..... 100 ..... 1010111  @vx
VMERGE_VIM 010111 0 ..... ..... 011 ..... 1010111  @vi
VMV_V_V    010111 1 00000 ..... 000 ..... 1010111  %vd %vs1
VMV_V_X    010111 1 00000 ..... 100 ..... 1010111  %vd %rs1
VMV_V_I    010111 1 00000 ..... 011 ..... 1010111  %vd %simm5

# --- Scalar move (extract/insert element 0) ---
VMV_X_S    010000 1 ..... 00000 010 ..... 1010111  %rd %vs2
VMV_S_X    010000 1 00000 ..... 110 ..... 1010111  %vd %rs1

# --- Mask instructions ---
VMAND_MM   011001 1 ..... ..... 010 ..... 1010111  @vv
VMNAND_MM  011101 1 ..... ..... 010 ..... 1010111  @vv
VMANDN_MM  011000 1 ..... ..... 010 ..... 1010111  @vv
VMXOR_MM   011011 1 ..... ..... 010 ..... 1010111  @vv
VMOR_MM    011010 1 ..... ..... 010 ..... 1010111  @vv
VMNOR_MM   011110 1 ..... ..... 010 ..... 1010111  @vv
VMORN_MM   011100 1 ..... ..... 010 ..... 1010111  @vv
VMXNOR_MM  011111 1 ..... ..... 010 ..... 1010111  @vv

# --- Mask population count, find-first, set-before-first ---
VCPOP_M    010000 . ..... 10000 010 ..... 1010111  %rd %vs2 %vm
VFIRST_M   010000 . ..... 10001 010 ..... 1010111  %rd %vs2 %vm
VMSBF_M    010100 . ..... 00001 010 ..... 1010111  %vd %vs2 %vm
VMSOF_M    010100 . ..... 00010 010 ..... 1010111  %vd %vs2 %vm
VMSIF_M    010100 . ..... 00011 010 ..... 1010111  %vd %vs2 %vm
VIOTA_M    010100 . ..... 10000 010 ..... 1010111  %vd %vs2 %vm
VID_V      010100 . 00000 10001 010 ..... 1010111  %vd %vm

# --- Zero/sign extend ---
VZEXT_VF2  010010 . ..... 00110 010 ..... 1010111  %vd %vs2 %vm
VZEXT_VF4  010010 . ..... 00100 010 ..... 1010111  %vd %vs2 %vm
VZEXT_VF8  010010 . ..... 00010 010 ..... 1010111  %vd %vs2 %vm
VSEXT_VF2  010010 . ..... 00111 010 ..... 1010111  %vd %vs2 %vm
VSEXT_VF4  010010 . ..... 00101 010 ..... 1010111  %vd %vs2 %vm
VSEXT_VF8  010010 . ..... 00011 010 ..... 1010111  %vd %vs2 %vm

# --- Single-width averaging add/sub ---
VAADDU_VV  001000 . ..... ..... 010 ..... 1010111  @vv
VAADDU_VX  001000 . ..... ..... 110 ..... 1010111  @vx
VAADD_VV   001001 . ..... ..... 010 ..... 1010111  @vv
VAADD_VX   001001 . ..... ..... 110 ..... 1010111  @vx
VASUBU_VV  001010 . ..... ..... 010 ..... 1010111  @vv
VASUBU_VX  001010 . ..... ..... 110 ..... 1010111  @vx
VASUB_VV   001011 . ..... ..... 010 ..... 1010111  @vv
VASUB_VX   001011 . ..... ..... 110 ..... 1010111  @vx

# --- Narrowing shift ---
VNSRL_WV   101100 . ..... ..... 000 ..... 1010111  @vv
VNSRL_WX   101100 . ..... ..... 100 ..... 1010111  @vx
VNSRL_WI   101100 . ..... ..... 011 ..... 1010111  @vi
VNSRA_WV   101101 . ..... ..... 000 ..... 1010111  @vv
VNSRA_WX   101101 . ..... ..... 100 ..... 1010111  @vx
VNSRA_WI   101101 . ..... ..... 011 ..... 1010111  @vi

# --- Reduction operations ---
VREDSUM_VS   000000 . ..... ..... 010 ..... 1010111  @vv
VREDMAXU_VS  000110 . ..... ..... 010 ..... 1010111  @vv
VREDMAX_VS   000111 . ..... ..... 010 ..... 1010111  @vv
VREDMINU_VS  000100 . ..... ..... 010 ..... 1010111  @vv
VREDMIN_VS   000101 . ..... ..... 010 ..... 1010111  @vv
VREDAND_VS   000001 . ..... ..... 010 ..... 1010111  @vv
VREDOR_VS    000010 . ..... ..... 010 ..... 1010111  @vv
VREDXOR_VS   000011 . ..... ..... 010 ..... 1010111  @vv

# ============================================================================
# Vector Floating-Point Instructions (opcode = 1010111, funct3 = 001/101)
# ============================================================================

# --- FP add/sub ---
VFADD_VV   000000 . ..... ..... 001 ..... 1010111  @vv
VFADD_VF   000000 . ..... ..... 101 ..... 1010111  @vx
VFSUB_VV   000010 . ..... ..... 001 ..... 1010111  @vv
VFSUB_VF   000010 . ..... ..... 101 ..... 1010111  @vx
VFRSUB_VF  100111 . ..... ..... 101 ..... 1010111  @vx

# --- FP multiply/divide ---
VFMUL_VV   100100 . ..... ..... 001 ..... 1010111  @vv
VFMUL_VF   100100 . ..... ..... 101 ..... 1010111  @vx
VFDIV_VV   100000 . ..... ..... 001 ..... 1010111  @vv
VFDIV_VF   100000 . ..... ..... 101 ..... 1010111  @vx
VFRDIV_VF  100001 . ..... ..... 101 ..... 1010111  @vx

# --- FP multiply-add ---
VFMACC_VV  101100 . ..... ..... 001 ..... 1010111  @vv
VFMACC_VF  101100 . ..... ..... 101 ..... 1010111  @vx
VFNMACC_VV 101101 . ..... ..... 001 ..... 1010111  @vv
VFNMACC_VF 101101 . ..... ..... 101 ..... 1010111  @vx
VFMSAC_VV  101110 . ..... ..... 001 ..... 1010111  @vv
VFMSAC_VF  101110 . ..... ..... 101 ..... 1010111  @vx
VFNMSAC_VV 101111 . ..... ..... 001 ..... 1010111  @vv
VFNMSAC_VF 101111 . ..... ..... 101 ..... 1010111  @vx
VFMADD_VV  101000 . ..... ..... 001 ..... 1010111  @vv
VFMADD_VF  101000 . ..... ..... 101 ..... 1010111  @vx
VFNMADD_VV 101001 . ..... ..... 001 ..... 1010111  @vv
VFNMADD_VF 101001 . ..... ..... 101 ..... 1010111  @vx
VFMSUB_VV  101010 . ..... ..... 001 ..... 1010111  @vv
VFMSUB_VF  101010 . ..... ..... 101 ..... 1010111  @vx
VFNMSUB_VV 101011 . ..... ..... 001 ..... 1010111  @vv
VFNMSUB_VF 101011 . ..... ..... 101 ..... 1010111  @vx

# --- FP min/max ---
VFMIN_VV   000100 . ..... ..... 001 ..... 1010111  @vv
VFMIN_VF   000100 . ..... ..... 101 ..... 1010111  @vx
VFMAX_VV   000110 . ..... ..... 001 ..... 1010111  @vv
VFMAX_VF   000110 . ..... ..... 101 ..... 1010111  @vx

# --- FP sign injection ---
VFSGNJ_VV  001000 . ..... ..... 001 ..... 1010111  @vv
VFSGNJ_VF  001000 . ..... ..... 101 ..... 1010111  @vx
VFSGNJN_VV 001001 . ..... ..... 001 ..... 1010111  @vv
VFSGNJN_VF 001001 . ..... ..... 101 ..... 1010111  @vx
VFSGNJX_VV 001010 . ..... ..... 001 ..... 1010111  @vv
VFSGNJX_VF 001010 . ..... ..... 101 ..... 1010111  @vx

# --- FP compare ---
VMFEQ_VV   011000 . ..... ..... 001 ..... 1010111  @vv
VMFEQ_VF   011000 . ..... ..... 101 ..... 1010111  @vx
VMFLE_VV   011001 . ..... ..... 001 ..... 1010111  @vv
VMFLE_VF   011001 . ..... ..... 101 ..... 1010111  @vx
VMFLT_VV   011011 . ..... ..... 001 ..... 1010111  @vv
VMFLT_VF   011011 . ..... ..... 101 ..... 1010111  @vx
VMFNE_VV   011100 . ..... ..... 001 ..... 1010111  @vv
VMFNE_VF   011100 . ..... ..... 101 ..... 1010111  @vx
VMFGT_VF   011101 . ..... ..... 101 ..... 1010111  @vx
VMFGE_VF   011111 . ..... ..... 101 ..... 1010111  @vx

# --- FP sqrt ---
VFSQRT_V   010011 . ..... 00000 001 ..... 1010111  %vd %vs2 %vm

# --- FP classify ---
VFCLASS_V  010011 . ..... 10000 001 ..... 1010111  %vd %vs2 %vm

# --- FP merge/move ---
VFMERGE_VFM 010111 0 ..... ..... 101 ..... 1010111 @vx
VFMV_V_F    010111 1 00000 ..... 101 ..... 1010111 %vd %rs1

# --- FP scalar move ---
VFMV_F_S   010000 1 ..... 00000 001 ..... 1010111  %rd %vs2
VFMV_S_F   010000 1 00000 ..... 101 ..... 1010111  %vd %rs1

# --- FP reductions ---
VFREDOSUM_VS 000011 . ..... ..... 001 ..... 1010111 @vv
