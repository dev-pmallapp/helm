# RISC-V RV64M Standard Extension — Multiply/Divide
# QEMU decodetree format
# helm-ng project

# ============================================================================
# Field definitions
# ============================================================================

%rd       7:5
%rs1     15:5
%rs2     20:5

# ============================================================================
# Argument sets and formats
# ============================================================================

&r       rd rs1 rs2
@r       ....... ..... ..... ... ..... ....... &r %rs2 %rs1 %rd

# ============================================================================
# RV64M — Multiply
# ============================================================================

MUL      0000001 ..... ..... 000 ..... 0110011 @r
MULH     0000001 ..... ..... 001 ..... 0110011 @r
MULHSU   0000001 ..... ..... 010 ..... 0110011 @r
MULHU    0000001 ..... ..... 011 ..... 0110011 @r

# ============================================================================
# RV64M — Divide / Remainder
# ============================================================================

DIV      0000001 ..... ..... 100 ..... 0110011 @r
DIVU     0000001 ..... ..... 101 ..... 0110011 @r
REM      0000001 ..... ..... 110 ..... 0110011 @r
REMU     0000001 ..... ..... 111 ..... 0110011 @r

# ============================================================================
# RV64M — Word-width variants (32-bit on 64-bit)
# ============================================================================

MULW     0000001 ..... ..... 000 ..... 0111011 @r
DIVW     0000001 ..... ..... 100 ..... 0111011 @r
DIVUW    0000001 ..... ..... 101 ..... 0111011 @r
REMW     0000001 ..... ..... 110 ..... 0111011 @r
REMUW    0000001 ..... ..... 111 ..... 0111011 @r
